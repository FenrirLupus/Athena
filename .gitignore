# The repository holds code and installers. It never holds a machine's state, a credential, or a build artefact.

# The program tree carries its own .gitignore; this one covers a staging copy made by sync.sh
athena-agent/__pycache__/
athena-agent/**/__pycache__/
*.py[co]
athena-agent/graphify/

# credentials
athena-agent/.secret
athena-agent/.env
athena-agent/.env.*
athena-agent/security/api_token

# per-installation state
athena-agent/profiles/
athena-agent/sessions/
athena-agent/metrics/
athena-agent/backups/
*.db
*.db-wal
*.db-shm
*.session
athena-agent/**/state.json
athena-agent/**/temporal.json
athena-agent/**/identity.json

# editor and OS noise
.DS_Store
*.swp
*~
